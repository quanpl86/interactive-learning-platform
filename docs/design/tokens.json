{
  "meta": {
    "name": "EduFlow Light — working design system",
    "theme": "light-only",
    "version": "1.0.0",
    "language": "vi",
    "note": "Project-local reference tokens; not final brand."
  },
  "color": {
    "page": "#F7F9FC",
    "surface": "#FFFFFF",
    "surfaceMuted": "#F1F5F9",
    "text": "#0F172A",
    "textSecondary": "#475569",
    "textMuted": "#64748B",
    "primary": "#047857",
    "primaryHover": "#065F46",
    "primarySoft": "#ECFDF5",
    "secondary": "#1D4ED8",
    "secondarySoft": "#EFF6FF",
    "border": "#DFE5EC",
    "borderStrong": "#CBD5E1",
    "focus": "#2563EB",
    "success": "#047857",
    "warning": "#92400E",
    "warningSoft": "#FFFBEB",
    "error": "#B91C1C",
    "errorSoft": "#FEF2F2",
    "editorBg": "#FFFFFF",
    "codeBg": "#F8FAFC"
  },
  "typography": {
    "fontFamily": "Inter, Segoe UI, Arial, sans-serif",
    "basePx": 16,
    "sizesPx": {
      "xs": 12,
      "sm": 14,
      "base": 16,
      "lg": 18,
      "xl": 22,
      "2xl": 28
    },
    "lineHeight": 1.55,
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "spacingPx": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40,
    48
  ],
  "radiusPx": {
    "sm": 6,
    "md": 10,
    "lg": 14
  },
  "borderPx": 1,
  "shadows": {
    "card": "none",
    "floating": "0 4px 20px rgba(15,23,42,.08)"
  },
  "layout": {
    "desktopSidebarPx": 228,
    "contentMaxPx": 1440,
    "breakpointsPx": {
      "tablet": 1024,
      "mobile": 720,
      "small": 360
    },
    "touchTargetMinPx": 44
  },
  "motion": {
    "durationMs": 150,
    "reducedMotion": true,
    "noAutoPlayDecorativeAnimation": true
  }
}
