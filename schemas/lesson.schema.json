{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quanpl86/interactive-learning-platform/schemas/lesson-v2.json",
  "title": "Interactive Lesson Contract v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "locale",
    "status",
    "objectives",
    "contentBlocks",
    "activities",
    "timeline",
    "checklist"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180
    },
    "locale": {
      "const": "vi-VN"
    },
    "status": {
      "enum": [
        "draft",
        "in-review",
        "approved",
        "published"
      ]
    },
    "durationSec": {
      "type": "number",
      "minimum": 0
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,79}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "contentBlocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "id",
              "type",
              "markdown"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,79}$"
              },
              "type": {
                "const": "markdown"
              },
              "markdown": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "type",
              "alt",
              "assetRef"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,79}$"
              },
              "type": {
                "const": "image"
              },
              "alt": {
                "type": "string",
                "minLength": 1
              },
              "assetRef": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_./-]+$"
              },
              "caption": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "type",
              "language",
              "code"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,79}$"
              },
              "type": {
                "const": "code"
              },
              "language": {
                "enum": [
                  "python",
                  "html",
                  "css",
                  "javascript",
                  "sql",
                  "text"
                ]
              },
              "code": {
                "type": "string"
              },
              "filename": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_./-]+$"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "type",
              "title",
              "url"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,79}$"
              },
              "type": {
                "const": "resource"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "media": {
      "type": "object",
      "required": [
        "videoRef"
      ],
      "properties": {
        "videoRef": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_./-]+$"
        },
        "subtitleRef": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_./-]+$"
        },
        "posterRef": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_./-]+$"
        },
        "assetRevision": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,79}$"
        }
      },
      "additionalProperties": false
    },
    "activities": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "id",
              "type",
              "question",
              "options",
              "correctOptionId",
              "completion"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,79}$"
              },
              "type": {
                "const": "quiz"
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "text"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "correctOptionId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
              },
              "completion": {
                "enum": [
                  "answered",
                  "correct"
                ]
              },
              "assessmentMode": {
                "const": "formative-client"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "type",
              "runtime",
              "files",
              "completion"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,79}$"
              },
              "type": {
                "const": "quick-code"
              },
              "runtime": {
                "enum": [
                  "python-console",
                  "web-static"
                ]
              },
              "files": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_./-]+$"
                },
                "additionalProperties": {
                  "type": "string"
                },
                "minProperties": 1,
                "maxProperties": 5
              },
              "completion": {
                "enum": [
                  "run",
                  "formative-tests"
                ]
              },
              "testSpecRef": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_./-]+$"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "type",
              "templateRef",
              "guideRef",
              "completion"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,79}$"
              },
              "type": {
                "const": "local-project"
              },
              "templateRef": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_./-]+$"
              },
              "guideRef": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_./-]+$"
              },
              "completion": {
                "enum": [
                  "submitted",
                  "teacher-reviewed"
                ]
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "atSec",
          "action",
          "targetId",
          "pause"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,79}$"
          },
          "atSec": {
            "type": "number",
            "minimum": 0
          },
          "action": {
            "enum": [
              "openQuiz",
              "openPractice",
              "openResource"
            ]
          },
          "targetId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,79}$"
          },
          "pause": {
            "type": "boolean"
          },
          "repeatable": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "evidence",
          "objectiveId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,79}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "objectiveId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,79}$"
          },
          "evidence": {
            "enum": [
              "self",
              "system",
              "teacher"
            ]
          },
          "activityId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,79}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
